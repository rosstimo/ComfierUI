# scripts/init.sh replaces auto with the highest-VRAM GPU UUID.
COMFYUI_GPU_DEVICE=auto

# Keep 8188 free while validating beside the legacy service.
COMFYUI_PORT=8189
COMFYUI_BIND_ADDRESS=0.0.0.0

# Image and upstream source selection.
COMFYUI_IMAGE_TAG=latest
COMFYUI_REF=master

# Container identity. scripts/init.sh replaces these with the invoking user.
PUID=1000
PGID=1000

COMFYUI_SHM_SIZE=8gb
TZ=America/Boise
