# Comprehensive environment-variable reference.
# scripts/init.sh generates a shorter .env containing only the normal local
# settings and the detected accelerator values. Copy options from this file only
# when you need to override an advanced default.

# Compose layers. scripts/init.sh selects NVIDIA or CPU automatically. The backup
# sidecar is included but remains idle unless COMFYUI_BACKUP_ENABLED=true.
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml:compose.backup.yaml
COMPOSE_PROJECT_NAME=comfierui

# Accelerator. Run scripts/init.sh in auto mode unless selecting a profile
# deliberately. CUDA 13 requires Turing-or-newer hardware and a 580+ driver.
COMFYUI_ACCELERATOR=nvidia
COMFYUI_NVIDIA_PROFILE=auto
COMFYUI_GPU_DEVICE=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Image and upstream source. Treat these as a compatibility set.
COMFYUI_IMAGE_REPOSITORY=local/comfierui
COMFYUI_IMAGE_TAG=latest
COMFYUI_BASE_IMAGE=nvidia/cuda:13.0.0-base-ubuntu24.04
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=v0.28.0
PYTORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
TORCHAUDIO_VERSION=2.11.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# Profile defaults used by scripts/init.sh. CUDA 12.6 is the compatibility
# profile for Maxwell, Pascal, Volta, or a 525-579 driver.
COMFYUI_CUDA13_BASE_IMAGE=nvidia/cuda:13.0.0-base-ubuntu24.04
COMFYUI_CUDA13_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
COMFYUI_CUDA12_BASE_IMAGE=nvidia/cuda:12.6.3-base-ubuntu24.04
COMFYUI_CUDA12_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
COMFYUI_CPU_BASE_IMAGE=ubuntu:24.04
COMFYUI_CPU_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Host identity. scripts/init.sh replaces PUID/PGID with the invoking user's IDs.
# COMFYUI_SHARED_GID adds one supplementary group for existing shared host paths
# without changing their ownership. Example: if a shared workflow directory is
# owned by group 1002, set COMFYUI_SHARED_GID=1002.
PUID=1000
PGID=1000
COMFYUI_SHARED_GID=1000
COMFYUI_UMASK=0002

# Host access. Localhost is the safer default. Use 0.0.0.0 only on a trusted
# network or behind an authenticated reverse proxy and firewall.
COMFYUI_BIND_ADDRESS=127.0.0.1
COMFYUI_PORT=8188

# Fresh .env files use the host timezone when it can be detected. This value is
# the fallback and an example for manual configuration.
TZ=Etc/UTC

# Persistent host paths. Keep the built-in model tree writable so Manager model
# downloads remain local to this deployment. Existing shared/legacy libraries
# can be added separately with COMFYUI_EXTRA_MODELS_PATH.
COMFYUI_DATA_PATH=./data
COMFYUI_MODELS_PATH=./data/models
COMFYUI_WORKFLOWS_PATH=./data/workflows

# Optional existing model library. Add this setting to .env and rerun
# scripts/init.sh. Initialization adds compose.extra-models.yaml to COMPOSE_FILE
# and pre-creates the nested mount point. The library is mounted read-only and
# registered through ComfyUI's extra_model_paths.yaml support.
COMFYUI_EXTRA_MODELS_PATH=/absolute/path/to/existing/models

# Manager. The familiar legacy interface is the convenience default because it
# includes server-side model search and installation. Set false to opt into the
# newer Manager interface.
COMFYUI_MANAGER_ENABLED=true
COMFYUI_MANAGER_LEGACY_UI=true
COMFYUI_MANAGER_SECURITY_LEVEL=normal
COMFYUI_MANAGER_NETWORK_MODE=personal_cloud

# Built-in automatic backups. Set COMFYUI_BACKUP_ENABLED=true. Docker Compose
# then runs an encrypted restic backup service; no host restic install, cron, or
# systemd timer is required.
COMFYUI_BACKUP_ENABLED=false
COMFYUI_BACKUP_PATH=./backups
COMFYUI_BACKUP_RESTIC_VERSION=0.19.1
COMFYUI_BACKUP_IMAGE_REPOSITORY=local/comfierui-backup
COMFYUI_BACKUP_IMAGE_TAG=latest

# Schedule. The first backup waits 10 minutes, then successful backups run every
# 24 hours. A failed backup retries after 60 minutes.
COMFYUI_BACKUP_INTERVAL_HOURS=24
COMFYUI_BACKUP_START_DELAY_MINUTES=10
COMFYUI_BACKUP_RETRY_MINUTES=60

# A manual backup waits for a newly started ComfyUI container to become healthy
# before stopping it, so the runtime-state record belongs to the current image.
COMFYUI_BACKUP_READY_TIMEOUT_SECONDS=300

# What to back up. Set an INCLUDE option to false to exclude it. Essential state
# is included by default. Potentially large image/model/Python data is opt-in.
# Models are reasonable to enable when availability, licensing, account access,
# or upstream deletion makes future re-download uncertain.
COMFYUI_BACKUP_INCLUDE_CONFIG=true
COMFYUI_BACKUP_INCLUDE_CUSTOM_NODES=true
COMFYUI_BACKUP_INCLUDE_USER=true
COMFYUI_BACKUP_INCLUDE_WORKFLOWS=true
COMFYUI_BACKUP_INCLUDE_INPUT=false
COMFYUI_BACKUP_INCLUDE_OUTPUT=false
COMFYUI_BACKUP_INCLUDE_MODELS=false
COMFYUI_BACKUP_INCLUDE_EXTRA_MODELS=false
COMFYUI_BACKUP_INCLUDE_PYTHON=false

# Fine-grained policy. The default example files are effectively empty. Copy them
# to the non-example names, edit them, and point these settings at the copies to
# add selected /source/... paths or apply restic exclude patterns. Local policy
# files are ignored by Git but copied into each recovery blueprint.
COMFYUI_BACKUP_INCLUDE_FILE=./config/backup-includes.txt.example
COMFYUI_BACKUP_EXCLUDE_FILE=./config/backup-excludes.txt.example

# Optional global file-size ceiling for backup payloads, for example 20G. Leave
# empty for no size limit. This applies after sources are selected.
COMFYUI_BACKUP_EXCLUDE_LARGER_THAN=

# Retention. These defaults keep recent recovery points plus longer history.
# Restic deduplicates unchanged content between snapshots.
COMFYUI_BACKUP_KEEP_LAST=3
COMFYUI_BACKUP_KEEP_DAILY=7
COMFYUI_BACKUP_KEEP_WEEKLY=4
COMFYUI_BACKUP_KEEP_MONTHLY=12
COMFYUI_BACKUP_KEEP_YEARLY=3
COMFYUI_BACKUP_TAG=comfierui
COMFYUI_BACKUP_RESTART_POLICY=unless-stopped

# Service behavior.
COMFYUI_RESTART_POLICY=unless-stopped
COMFYUI_STOP_GRACE_PERIOD=30s
COMFYUI_SHM_SIZE=8gb
COMFYUI_HEALTH_INTERVAL=30s
COMFYUI_HEALTH_TIMEOUT=10s
COMFYUI_HEALTH_RETRIES=5
COMFYUI_HEALTH_START_PERIOD=90s
COMFYUI_EXTRA_ARGS=

# Optional shared network. Append compose.external-network.yaml to COMPOSE_FILE
# and set this to an existing Docker network name.
COMFYUI_EXTERNAL_NETWORK=comfyui-shared
