# scripts/init.sh replaces auto with the highest-VRAM GPU UUID.
COMFYUI_GPU_DEVICE=auto

# Keep 8188 free while validating beside the legacy service.
COMFYUI_PORT=8189
COMFYUI_BIND_ADDRESS=0.0.0.0

# Image and upstream source selection.
COMFYUI_IMAGE_TAG=latest
COMFYUI_REF=master

# Use the current Manager UI by default. Set true for the familiar legacy UI.
COMFYUI_MANAGER_LEGACY_UI=false

# Container identity. scripts/init.sh replaces these with the invoking user.
PUID=1000
PGID=1000

# Model library. Defaults to a deployment-local directory.
# For a shared existing library, set both values to its host path and group ID.
COMFYUI_MODELS_PATH=./data/models
COMFYUI_MODELS_GID=1000

COMFYUI_SHM_SIZE=8gb
TZ=America/Boise
