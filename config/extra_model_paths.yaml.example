# Copy to config/extra_model_paths.yaml. Paths here are container paths, not
# host paths. Mount each host library into the container with an override such
# as examples/compose.extra-model-paths.yaml.
external_models:
  base_path: /mnt/external-models
  checkpoints: checkpoints
  clip: clip
  clip_vision: clip_vision
  controlnet: controlnet
  embeddings: embeddings
  loras: loras
  upscale_models: upscale_models
  vae: vae
