# Advanced external/host-managed restic example.
#
# Normal users do not need this file. Built-in automatic backups are configured
# directly in .env with COMFYUI_BACKUP_* settings and run inside Docker Compose.
# Copy this file to config/restic.env only when integrating ComfierUI with a host
# restic installation, another disk/system, or an existing backup framework.
RESTIC_REPOSITORY=/path/to/restic-repository
RESTIC_PASSWORD_FILE=/path/to/restic-password-file
RESTIC_TAG=comfierui

# Retention policy used by scripts/restic-maintenance.sh.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12

# Critical state is included by default. Large or reproducible content is opt-in.
# Workflows and ComfyUI images may contain prompts, workflow metadata, API keys,
# or access tokens. Restic encrypts repository contents; protect the repository
# credentials and treat restored data as sensitive.
COMFYUI_BACKUP_LOCAL_CONFIG=true
COMFYUI_BACKUP_CUSTOM_NODES=true
COMFYUI_BACKUP_USER=true
COMFYUI_BACKUP_WORKFLOWS=true
COMFYUI_BACKUP_INPUT=true
COMFYUI_BACKUP_OUTPUT=false
COMFYUI_BACKUP_MODELS=false

# Optional separate legacy/shared model library configured by
# COMFYUI_EXTRA_MODELS_PATH in .env. This is independent of COMFYUI_BACKUP_MODELS.
COMFYUI_BACKUP_EXTRA_MODELS=false

COMFYUI_BACKUP_PYTHON_VOLUME=false

# Stop ComfyUI while collecting a consistent backup. Recommended when backing
# up the Python volume or while Manager installs/updates may be running.
COMFYUI_BACKUP_STOP_SERVICE=true

# Maintenance checks. A full data read can be expensive; schedule it separately.
RESTIC_CHECK_READ_DATA_SUBSET=5%
