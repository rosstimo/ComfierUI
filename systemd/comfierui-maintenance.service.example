[Unit]
Description=Maintain and check the ComfierUI restic repository
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/path/to/ComfierUI
Environment=RESTIC_ENV_FILE=/path/to/ComfierUI/config/restic.env
Environment=RESTIC_EXCLUDE_FILE=/path/to/ComfierUI/config/restic-excludes.txt
StateDirectory=comfierui-backup
UMask=0077
NoNewPrivileges=true
ExecStart=/usr/bin/flock -n /var/lib/comfierui-backup/restic.lock /path/to/ComfierUI/scripts/restic-maintenance.sh regular
Nice=15
IOSchedulingClass=idle
